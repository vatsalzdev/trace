{
  "name": "trace",
  "private": true,
  "version": "1.0.0",
  "description": "TRACE — cybercrime investigation & threat intelligence platform",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c \"#8b8bff,#4ade80\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run typecheck -w server",
    "seed": "npm run seed -w server",
    "sample:apk": "npm run sample:apk -w server",
    "blocklist:import": "tsx server/scripts/import-blocklist.ts",
    "preview": "npm run preview -w client",
    "start": "npm run start -w server",
    "test:api": "node --test tests/api.test.mjs && tsx --test tests/phase-d.test.ts",
    "eval": "tsx eval/run.ts",
    "eval:heldout": "tsx eval/heldout/run.ts",
    "test:e2e": "playwright test",
    "test:contrast": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node-forge": "^1.3.14",
    "concurrently": "^9.1.2",
    "pdf-parse": "^2.4.5"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "node-forge": "^1.4.4",
    "tldts": "^7.5.5"
  }
}
